# Production runtime environment for the web container.
#
# Repo-only documentation of the variables the web container reads; it is
# never shipped. In production the values come from the cluster's Secret and
# Deployment env (martinkrakowski/platform, apps/production/hexagen-web), not
# from this file. LLM_MODEL is also the NEXT_PUBLIC_LLM_MODEL build arg, which
# build-image.yml reads from the LLM_MODEL repository secret.

# Canonical production URL. NextAuth builds the OAuth redirect_uri from this;
# must match the GitHub OAuth App's Authorization callback URL
# (https://app.hexagen-monaco.cloud/api/auth/callback/github). Hardcoded in the
# workflow (not a secret).
NEXTAUTH_URL=https://app.hexagen-monaco.cloud

# NextAuth session secret. The app reads NEXTAUTH_SECRET; the deploy writes it
# from the AUTH_SECRET repo secret. AUTH_SECRET is also written for back-compat.
NEXTAUTH_SECRET=
AUTH_SECRET=

# Single-tenant platform sqlite (accounts, projects, run history, entitlements).
# Mounted on the same /data volume as quota/BYOK.
PLATFORM_DB_PATH=/data/platform.db

# PLATFORM_DB=sqlite is set by the compose file. With NODE_ENV=production the
# service needs DATABASE_URL (Postgres) or PLATFORM_DB=sqlite to start; with
# both set Postgres is used and the service logs a warning.
# A local production start (`yarn build && yarn start`, or the standalone
# `server.js`) needs one of the two as well.

# Stripe (repo-priced plans). Empty = entitlement seam stays on the free quota.
# Never required for generate-route metering (quota-D2).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_REPO_MONTHLY=

# GitHub OAuth App credentials. Stored in repo secrets as GH_OAUTH_ID /
# GH_OAUTH_SECRET (GitHub forbids GITHUB_-prefixed secret names) and written to
# .env as GITHUB_ID / GITHUB_SECRET, which NextAuth reads.
GITHUB_ID=
GITHUB_SECRET=

# Generic LLM provider (optional — AI-assist features). Doubles as (a) the
# generic OpenAI-compatible slot in the staged-generation fallback chain and
# (b) the fallback key for the web chat/governance routes (see WEB_LLM_API_KEY).
# The mercury prod flip UNSETS LLM_API_KEY — runbook:
# docs/planning/mercury-2-prod-flip-runbook.md
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Web-feature LLM key (PR #301). The chat route's server-key path and the
# governance suggestion routes resolve WEB_LLM_API_KEY ?? LLM_API_KEY
# (resolveWebLlmApiKey in wire.shared.ts). MUST be set before the flip unsets
# LLM_API_KEY, or chat degrades to auth/BYOK-only and governance suggestions
# return empty. Also feeds the NEXT_PUBLIC_LLM_AVAILABLE build arg (true when
# either key is set).
WEB_LLM_API_KEY=

# Inception (Mercury) provider — the staged-generation chain's mercury slot.
# Empty INCEPTION_API_KEY = provider skipped by the fallback chain.
# INCEPTION_MODEL is a repository VARIABLE (default mercury-2).
INCEPTION_API_KEY=
INCEPTION_MODEL=

# Reasoning knob (repository VARIABLE): disabled|low|medium|high; empty =
# provider default. The VALIDATED mercury prod regime is `low` — NOT
# `disabled` (Inception's "instant" mode dropped to 62.5% success with NDJSON
# failures in the model sweep). See the flip runbook.
LLM_REASONING=

# Stage-1 draft→refine cascade (PR #300). Empty STAGE1_REFINER_API_KEY =
# cascade off (ships dark). The dedicated key var keeps the refiner's key out
# of the main fallback chain's resolution. Knobs are repository VARIABLES:
# BASE_URL default https://openrouter.ai/api/v1, MODEL default openai/gpt-4o,
# MODE = always (default) | escalation.
STAGE1_REFINER_API_KEY=
STAGE1_REFINER_BASE_URL=
STAGE1_REFINER_MODEL=
STAGE1_REFINER_MODE=

# Stage-7 verify-and-repair reviewer (PR #343). Empty STAGE6_REVIEWER_API_KEY =
# repair off (Stage 6 stays report-only). When set, Stage 7 hands the Stage-6
# findings to a stronger model that emits a corrected config, re-validated +
# structure-gated before it can replace the manifest. Knobs are repository
# VARIABLES: BASE_URL default https://openrouter.ai/api/v1, MODEL default
# openai/gpt-4o.
STAGE6_REVIEWER_API_KEY=
STAGE6_REVIEWER_BASE_URL=
STAGE6_REVIEWER_MODEL=

# Jev decision advice (Jev J5a1, plan docs/planning/2026-10-16-jev-decision-advice.md).
JEV_API_KEY=
# off (default) | shadow | primary — U-A context-type advice mode; anything else stays off.
JEV_CONTEXT_TYPE_MODE=
# Jev confidence floor for primary to apply; default 0.8, clamped to 0..1.
JEV_CONTEXT_TYPE_MIN_CONFIDENCE=
# Per-generation Jev call cap; default 20.
JEV_MAX_CALLS_PER_GENERATION=
# Daily Jev spend ceiling in USD; default 0.50.
JEV_DAILY_COST_CEILING_USD=
# on | off (default off) — U-C template-select suggestion.
JEV_TEMPLATE_SUGGEST=
# Reviewer's JWT sub; empty keeps reviewer=false everywhere and the review route closed.
JEV_REVIEWER_SUB=

# DELIBERATELY NOT PLUMBED: LLM_ESCALATION_MODEL. The stage-3 escalation model
# injection is provider-unscoped — a foreign model name in an Inception-only
# chain would 404 every escalation retry. Keeping it out of the deploy heredoc
# makes "unset in prod" structural rather than procedural.
#
# ALSO NOT PLUMBED: OPENAI_API_KEY / ANTHROPIC_API_KEY. The fallback chain's
# openai-primary and anthropic slots exist in code but can never resolve on
# this deploy path — the prod chain is generic(LLM_API_KEY) + inception by
# construction. Plumbing them would put them AHEAD of mercury in the chain;
# don't, without re-reading the flip runbook's pins.

# (Removed in A4) The staged-generation pipeline is always the full 0→6
# pipeline now — the stub and its STAGED_GENERATION_PIPELINE / _FULL_PERCENT
# selection vars were deleted with it. Nothing reads them; do not re-add.

# OpenTelemetry AI telemetry (Arize Phoenix via Alloy). Empty endpoint disables
# the OTLP tracer entirely. Traces carry no prompt, message, response or user
# text — span attributes are limited to model/provider/operation/token counts.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_DEPLOYMENT_ENVIRONMENT=unknown
