# Production runtime environment for the web container.
#
# Repo-only documentation — this file is NEVER shipped to the VPS. The real
# `.env` is generated at deploy time by .github/workflows/deploy.yml (written to
# /opt/hexagen-monaco/.env) and consumed by deploy/docker-compose.prod.yml via
# `env_file`. Values are sourced from GitHub Actions repository secrets unless
# a key's own comment says otherwise (NEXTAUTH_URL is hardcoded in the
# workflow; the STAGED_GENERATION_* canary knobs are repository VARIABLES so
# they stay readable/auditable and flippable without secrets access).

# Canonical production URL. NextAuth builds the OAuth redirect_uri from this;
# must match the GitHub OAuth App's Authorization callback URL
# (https://app.hexagen-monaco.cloud/api/auth/callback/github). Hardcoded in the
# workflow (not a secret).
NEXTAUTH_URL=https://app.hexagen-monaco.cloud

# NextAuth session secret. The app reads NEXTAUTH_SECRET; the deploy writes it
# from the AUTH_SECRET repo secret. AUTH_SECRET is also written for back-compat.
NEXTAUTH_SECRET=
AUTH_SECRET=

# GitHub OAuth App credentials. Stored in repo secrets as GH_OAUTH_ID /
# GH_OAUTH_SECRET (GitHub forbids GITHUB_-prefixed secret names) and written to
# .env as GITHUB_ID / GITHUB_SECRET, which NextAuth reads.
GITHUB_ID=
GITHUB_SECRET=

# LLM provider (optional — AI-assist features). Empty LLM_API_KEY disables them.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# A3 staged-generation canary (sourced from GitHub Actions repository
# VARIABLES, not secrets). Fail-closed: empty pin falls through to the canary
# percent; empty/NaN/negative percent means 0 = every request served by the
# stub. STAGED_GENERATION_PIPELINE=full|stub hard-pins (stub overrides the
# percent — the one-flip rollback lever).
# Runbook: docs/planning/staged-generation-canary-runbook.md
STAGED_GENERATION_PIPELINE=
STAGED_GENERATION_FULL_PERCENT=
