{
  "root": true,
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/recommended",
    "turbo",
    "prettier"
  ],
  "parser": "@typescript-eslint/parser",
  "plugins": ["@typescript-eslint", "import"],
  "rules": {
    "no-console": "warn",
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": [
              "@hexagen/*/*",
              "!@hexagen/shared/*",
              "!@hexagen/local-llm/shared",
              "!@hexagen/*/server",
              "!@hexagen/*/client"
            ],
            "message": "Deep subpath imports are not allowed. Import from the package barrel or a declared /server or /client subpath."
          }
        ]
      }
    ]
  },
  "ignorePatterns": ["dist", "node_modules", "**/*.js"],
  "overrides": [
    {
      "files": ["**/src/application/ports/in/*.ts"],
      "rules": {
        "@typescript-eslint/no-explicit-any": "off",
        "@typescript-eslint/no-unused-vars": "off"
      }
    },
    {
      "files": ["**/src/application/use-cases/*.ts"],
      "rules": {
        "@typescript-eslint/no-explicit-any": "off",
        "@typescript-eslint/no-unused-vars": "off"
      }
    },
    {
      "files": ["**/src/infrastructure/adapters/**/*.ts"],
      "rules": {
        "@typescript-eslint/no-unused-vars": "off"
      }
    },
    {
      "files": [
        "**/__tests__/**/*.ts",
        "**/*.test.ts",
        "**/*.spec.ts",
        "**/doubles/**/*.ts",
        "**/fakes/**/*.ts"
      ],
      "rules": {
        "@typescript-eslint/no-explicit-any": "off",
        "no-console": "off"
      }
    }
  ]
}
