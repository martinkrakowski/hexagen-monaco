{
  "name": "@hexagen/prompt-compiler",
  "version": "0.12.0",
  "description": "Prompt compilation from DomainAST, governance, and user intent for LLM consumption",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/fix-esm-barrels.js dist",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hexagen/core-domain": "workspace:*",
    "@hexagen/governance": "workspace:*",
    "@hexagen/project-configuration": "workspace:*",
    "@hexagen/shared": "workspace:*",
    "@hexagen/transaction-system": "workspace:*",
    "@hexagen/visualization": "workspace:*",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.8",
    "tsx": "^4.21.0",
    "typescript": "^5.4.5",
    "vitest": "^4.1.9"
  },
  "private": true,
  "type": "module"
}
