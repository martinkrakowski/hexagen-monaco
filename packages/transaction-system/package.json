{
  "name": "@hexagen/transaction-system",
  "version": "0.11.0",
  "description": "Transaction orchestration — speculative state machine, backpressure control, semantic caching",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/infrastructure/adapters/server.d.ts",
      "default": "./dist/infrastructure/adapters/server.js"
    },
    "./infrastructure/adapters/server": {
      "types": "./dist/infrastructure/adapters/server.d.ts",
      "default": "./dist/infrastructure/adapters/server.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hexagen/core-domain": "workspace:*",
    "@hexagen/shared": "workspace:*",
    "@hexagen/sync": "workspace:*"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.8",
    "tsx": "^4.21.0",
    "typescript": "^5.4.5",
    "vitest": "^4.1.9"
  },
  "private": true,
  "type": "module"
}
