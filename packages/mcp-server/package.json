{
  "name": "@hexagen/mcp-server",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "hexagen-mcp": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "start": "node dist/cli.js --workspace-root ../.."
  },
  "dependencies": {
    "@hexagen/agentic-interaction": "workspace:*",
    "@hexagen/governance": "workspace:*",
    "@hexagen/messaging": "workspace:*",
    "@hexagen/project-configuration": "workspace:*",
    "@hexagen/report-governance": "workspace:*",
    "@hexagen/shared": "workspace:*",
    "@hexagen/sync": "workspace:*",
    "@hexagen/transaction-system": "workspace:*",
    "@hexagen/visualization": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "js-yaml": "^4.1.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "eslint": "^8.57.0",
    "js-yaml": "^4.1.1",
    "tsx": "^4.21.0",
    "typescript": "^5.4.5",
    "vitest": "^4.1.9"
  }
}
