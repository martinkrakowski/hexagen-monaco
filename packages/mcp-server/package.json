{
  "name": "@hexagen/mcp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "hexagen-mcp": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint . --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test __tests__/**/*.test.ts",
    "start": "node dist/cli.js"
  },
  "dependencies": {
    "@hexagen/messaging": "workspace:*",
    "@hexagen/project-configuration": "workspace:*",
    "@hexagen/shared": "workspace:*",
    "@hexagen/sync": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "js-yaml": "^4.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "eslint": "^8.57.0",
    "tsx": "^4.19.2",
    "typescript": "^5.0.0"
  }
}
