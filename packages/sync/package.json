{
  "name": "@hexagen/sync",
  "version": "0.1.0",
  "type": "module",
  "description": "HexaGen Sync Engine — Generate and sync modular monorepos",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "hexagen": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json --emitDeclarationOnly && node ../../scripts/fix-esm-barrels.js dist",
    "typecheck": "tsc --noEmit",
    "cli": "node dist/cli.js",
    "pack:prepare": "node ../../scripts/prepare-publish-package.js .",
    "test": "tsx --test \"__tests__/**/*.test.ts\" \"__tests__/**/*.spec.ts\"",
    "test:watch": "tsx --test --watch \"__tests__/**/*.test.ts\" \"__tests__/**/*.spec.ts\"",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit"
  },
  "keywords": [
    "hexagonal-architecture",
    "monorepo",
    "code-generation"
  ],
  "dependencies": {
    "@hexagen/governance": "workspace:*",
    "@hexagen/project-configuration": "workspace:*",
    "@hexagen/shared": "workspace:*",
    "@hexagen/visualization": "workspace:*",
    "commander": "^14.0.3",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.3.5",
    "tsup": "^8.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "private": true
}
