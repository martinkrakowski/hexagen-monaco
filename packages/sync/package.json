{
  "name": "@hexagen/sync",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "HexaGen Sync Engine — Generate and sync modular monorepos",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "hexagen": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "cli": "node dist/cli.js",
    "test": "tsx --test __tests__/**/*.test.ts __tests__/**/*.spec.ts || true",
    "test:watch": "tsx --test --watch __tests__/**/*.test.ts __tests__/**/*.spec.ts",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit"
  },
  "keywords": [
    "hexagonal-architecture",
    "monorepo",
    "code-generation"
  ],
  "license": "MIT",
  "dependencies": {
    "@hexagen/shared": "workspace:*",
    "commander": "^14.0.3",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  }
}
