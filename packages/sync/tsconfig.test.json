{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "../..",
    "composite": false,
    "skipLibCheck": true,
    "moduleResolution": "NodeNext"
  },
  "include": [
    "src/**/*.ts",
    "__tests__/**/*.ts",
    "tests/**/*.ts",
    "../shared/src/**/*.ts"
  ]
}
