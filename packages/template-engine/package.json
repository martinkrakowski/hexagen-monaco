{
  "name": "@hexagen/template-engine",
  "version": "0.9.0",
  "type": "module",
  "description": "Hexagen add-on template system — registry, question engine, file emitter, and dependency resolution",
  "license": "SEE LICENSE IN LICENSE",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./in-memory": {
      "types": "./dist/in-memory.d.ts",
      "default": "./dist/in-memory.js"
    }
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "gen:bundle": "tsx scripts/generate-template-bundle.ts"
  },
  "dependencies": {
    "@hexagen/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "tsx": "^4.21.0",
    "typescript": "^5.4.5",
    "vitest": "^4.1.9"
  },
  "private": true
}
