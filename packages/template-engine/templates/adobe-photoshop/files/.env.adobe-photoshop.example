# --- Adobe Photoshop API ---
# Enabled operations: {operations}
# The Photoshop API is on image.adobe.io (NOT firefly-api.adobe.io). Auth is the
# same IMS Server-to-Server token. Override the host only if Adobe relocates it.
ADOBE_PHOTOSHOP_BASE_URL=https://image.adobe.io
# Default render output format (jpeg|png); override per call via RenderPsdRequest.
ADOBE_PHOTOSHOP_FORMAT={output_format}
