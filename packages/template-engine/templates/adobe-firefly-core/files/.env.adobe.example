# --- Adobe Firefly Services — Core ---
# Copy values into .env.local. check:env enforces the `# required` vars below.

# Adobe IMS — OAuth Server-to-Server (NOT JWT; the Service-Account/JWT flow is retired)
ADOBE_CLIENT_ID=                                     # required
ADOBE_CLIENT_SECRET=                                 # required
ADOBE_SCOPES=openid,AdobeID,firefly_api,ff_apis      # scope set depends on your entitlements
ADOBE_IMS_ORG_ID=                                    # x-gw-ims-org-id on some services
ADOBE_IMS_HOST={ims_region}.adobelogin.com
ADOBE_FIREFLY_BASE_URL=https://firefly-api.adobe.io

# Async jobs (job_mode={job_mode})
ADOBE_JOB_POLL_INTERVAL_MS=2000
ADOBE_WEBHOOK_SECRET=                                # only if job_mode=webhook (verifier fails closed without it)
