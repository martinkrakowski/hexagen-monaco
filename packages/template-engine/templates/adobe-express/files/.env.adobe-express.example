# --- Adobe Express API (batch automation) ---
# The Express batch API is reached via the base URL below; it defaults to the
# image.adobe.io host family (same IMS Server-to-Server token as Firefly, NOT
# firefly-api.adobe.io). Verify the current host/path against Adobe docs.
ADOBE_EXPRESS_BASE_URL=https://image.adobe.io
# Default output format for rendered variants (jpg|png|pdf).
ADOBE_EXPRESS_FORMAT={output_format}
