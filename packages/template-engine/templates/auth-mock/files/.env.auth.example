# ─── Authentication ───────────────────────────────────────────────────────────
# AUTH_MODE=mock makes the dev middleware short-circuit every request as
# MOCK_USER. Any other value (or unset) lets a real provider's middleware
# (google-oauth, supabase, etc.) take over.
AUTH_MODE=mock

# ─── Session cookie (used by src/infrastructure/auth/session/session-manager) ─
# The cookie name + max-age that Group A real-provider middlewares use when
# reading/writing their encrypted session. Provider-secret material (AES key)
# is configured per-provider (e.g. AUTH_SESSION_SECRET for google-oauth).
AUTH_COOKIE_NAME={session_cookie_name}
AUTH_SESSION_MAX_AGE=604800

# ─── Mock user (only used when AUTH_MODE=mock) ────────────────────────────────
MOCK_USER_ID=00000000-0000-0000-0000-000000000001
MOCK_USER_NAME={mock_user_name}
MOCK_USER_EMAIL={mock_user_email}
MOCK_USER_ROLES={mock_user_roles}
MOCK_USER_AVATAR_URL=
