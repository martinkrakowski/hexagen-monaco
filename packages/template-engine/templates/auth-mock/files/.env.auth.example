# ─── Authentication ───────────────────────────────────────────────────────────
# Toggle between mock (dev/demo) and real (production) auth
AUTH_MODE=mock

# Session cookie name — must match the name used by the middleware
AUTH_COOKIE_NAME={session_cookie_name}

# Session max age in seconds (default: 604800 = 7 days)
AUTH_SESSION_MAX_AGE=604800

# Secret used to sign sessions in real mode — generate with: openssl rand -hex 32
AUTH_SESSION_SECRET=

# ─── Protected Paths ──────────────────────────────────────────────────────────
# Comma-separated path prefixes that require authentication
AUTH_PROTECTED_PATHS={protected_paths}

# ─── Mock User (only used when AUTH_MODE=mock) ────────────────────────────────
MOCK_USER_ID=usr_demo_001
MOCK_USER_NAME={mock_user_name}
MOCK_USER_EMAIL={mock_user_email}
MOCK_USER_ROLES={mock_user_roles}
MOCK_USER_AVATAR_URL=
