# --- Adobe Firefly — Azure Blob Presigned Storage ---
# Mints SAS URLs (read for inputs, create/write for outputs). Set the account +
# container. Signing: set ADOBE_AZURE_STORAGE_KEY for account-key signing, OR leave
# it unset to use a managed identity (DefaultAzureCredential) user-delegation SAS.
# SAS lifetime is set at install time (url_expiry_seconds).
ADOBE_AZURE_STORAGE_ACCOUNT=                         # required
ADOBE_AZURE_CONTAINER=                               # required
ADOBE_AZURE_STORAGE_KEY=                             # optional; unset = managed-identity (user-delegation) SAS
ADOBE_AZURE_PREFIX=
