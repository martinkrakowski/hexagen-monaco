{
  "id": "llm-adapter",
  "name": "LLM Adapter",
  "description": "Typed port interface, provider adapters (xAI, OpenAI, Anthropic, Ollama, Azure OpenAI), model constants, reasoning routing, retry logic, structured output",
  "version": "1.0.0",
  "requires": ["env-setup", "error-handling"],
  "conflicts": [],
  "questions": [
    {
      "id": "providers",
      "type": "multiselect",
      "prompt": "Which LLM providers do you need?",
      "options": ["xai", "openai", "anthropic", "ollama", "azure-openai"],
      "default": ["xai"]
    },
    {
      "id": "primary_provider",
      "type": "select",
      "prompt": "Primary provider for orchestration (must be one of the providers selected above)?",
      "options": ["xai", "openai", "anthropic", "ollama", "azure-openai"],
      "default": "xai"
    },
    {
      "id": "reasoning_routing",
      "type": "boolean",
      "prompt": "Route orchestration calls to a dedicated reasoning model?",
      "default": true
    },
    {
      "id": "structured_output",
      "type": "boolean",
      "prompt": "Need structured JSON output with Zod schema validation?",
      "default": true
    },
    {
      "id": "streaming",
      "type": "boolean",
      "prompt": "Enable streaming responses?",
      "default": false
    },
    {
      "id": "default_timeout_ms",
      "type": "select",
      "prompt": "Default request timeout (ms)?",
      "options": ["15000", "30000", "60000", "120000"],
      "default": "30000"
    },
    {
      "id": "max_retries",
      "type": "select",
      "prompt": "Max retries on transient failure?",
      "options": ["0", "1", "2", "3"],
      "default": "2"
    }
  ],
  "envVars": [
    "XAI_API_KEY",
    "XAI_BASE_URL",
    "OPENAI_API_KEY",
    "OPENAI_BASE_URL",
    "OPENAI_REASONING_MODEL",
    "OPENAI_FAST_MODEL",
    "OPENAI_VISION_MODEL",
    "ANTHROPIC_API_KEY",
    "ANTHROPIC_REASONING_MODEL",
    "ANTHROPIC_FAST_MODEL",
    "ANTHROPIC_VISION_MODEL",
    "OLLAMA_BASE_URL",
    "OLLAMA_REASONING_MODEL",
    "OLLAMA_FAST_MODEL",
    "OLLAMA_VISION_MODEL",
    "AZURE_OPENAI_API_KEY",
    "AZURE_OPENAI_ENDPOINT",
    "AZURE_OPENAI_DEPLOYMENT",
    "AZURE_OPENAI_REASONING_DEPLOYMENT",
    "AZURE_OPENAI_FAST_DEPLOYMENT",
    "AZURE_OPENAI_VISION_DEPLOYMENT",
    "LLM_REASONING_MODEL",
    "LLM_FAST_MODEL",
    "LLM_VISION_MODEL",
    "LLM_DEFAULT_TIMEOUT_MS",
    "LLM_MAX_RETRIES"
  ],
  "outputs": [
    "src/domain/ports/out/llm-client.port.ts",
    "src/infrastructure/llm/constants/models.ts",
    "src/infrastructure/llm/constants/capabilities.ts",
    "src/infrastructure/llm/errors/llm-errors.ts",
    "src/infrastructure/llm/utils/parse-env.ts",
    "src/infrastructure/llm/utils/retry.ts",
    "src/infrastructure/llm/utils/timeout.ts",
    "src/infrastructure/llm/utils/structured-output.ts",
    "src/infrastructure/llm/adapters/xai-llm-client.adapter.ts",
    "src/infrastructure/llm/adapters/openai-llm-client.adapter.ts",
    "src/infrastructure/llm/adapters/anthropic-llm-client.adapter.ts",
    "src/infrastructure/llm/adapters/ollama-llm-client.adapter.ts",
    "src/infrastructure/llm/adapters/azure-openai-llm-client.adapter.ts",
    "src/infrastructure/llm/router/llm-router.ts",
    "src/infrastructure/llm/router/provider-registry.ts",
    "src/infrastructure/llm/index.ts",
    "src/infrastructure/llm/smoke-test.ts",
    ".env.llm.example"
  ],
  "checklist": [
    "Copy .env.llm.example values into your .env.local",
    "Add your API key(s) for the provider(s) you selected",
    "Confirm primary_provider is included in your providers list",
    "Verify LLM_REASONING_MODEL matches a model available on your current API tier",
    "Run: npx tsx src/infrastructure/llm/smoke-test.ts to verify provider wiring",
    "See SETUP.md → LLM Adapter for model reference and tier limits"
  ],
  "branch": "feature/generator-template-llm-adapter"
}
