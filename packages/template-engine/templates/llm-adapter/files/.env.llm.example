# ─── LLM — xAI ───────────────────────────────────────────────────────────────
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1

# ─── LLM — OpenAI (remove if not using) ─────────────────────────────────────
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# ─── LLM — Anthropic (remove if not using) ───────────────────────────────────
ANTHROPIC_API_KEY=

# ─── LLM — Ollama (local, no key required) ───────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434

# ─── LLM — Azure OpenAI (remove if not using) ────────────────────────────────
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# ─── LLM Routing ─────────────────────────────────────────────────────────────
# Model used for orchestration / complex reasoning calls
LLM_REASONING_MODEL=grok-3-mini
# Model used for wizard / fast completions
LLM_FAST_MODEL=grok-3-fast
# Model used for vision calls
LLM_VISION_MODEL=grok-2-vision

# ─── LLM Resilience ──────────────────────────────────────────────────────────
# Request timeout in milliseconds (default: 30000)
LLM_DEFAULT_TIMEOUT_MS=30000
# Maximum retries on transient failures (service errors, rate limits)
LLM_MAX_RETRIES=2
