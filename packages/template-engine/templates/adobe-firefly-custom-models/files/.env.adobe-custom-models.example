# --- Adobe Firefly — Custom Models ---
# Custom model training + inference on firefly-api.adobe.io (the core
# ADOBE_FIREFLY_BASE_URL). Training is LONG-RUNNING (minutes–hours) — prefer
# webhook job_mode (raise ADOBE_WEBHOOK_TIMEOUT_MS); scale ADOBE_JOB_POLL_INTERVAL_MS
# up if polling. Dataset caption format is set at install ({dataset_caption_format}).
ADOBE_FIREFLY_BASE_MODEL=firefly_v3                  # base model to fine-tune from; verify against Adobe docs
