# --- Bedrock AgentCore Services ---
# Enabled services: {services}
# Copy into .env.local. Values are populated after `agentcore add ...` + `agentcore status`.
# Region is never hardcoded in adapters — it falls back AGENTCORE_REGION -> AWS_REGION -> SDK chain.
# AGENTCORE_REGION=

# AgentCore Memory (if 'memory' enabled)
AGENTCORE_MEMORY_ID=
AGENTCORE_MEMORY_NAMESPACE=default

# AgentCore Gateway (if 'gateway' enabled)
AGENTCORE_GATEWAY_URL=
AGENTCORE_GATEWAY_ID=

# AgentCore Identity (if 'identity' enabled)
# The adapter needs the workload *name*: set AGENTCORE_WORKLOAD_NAME, or leave it
# unset and it is derived from the final path segment of the ARN below.
AGENTCORE_WORKLOAD_NAME=
AGENTCORE_WORKLOAD_IDENTITY_ARN=
AGENTCORE_IDP_DISCOVERY_URL=
