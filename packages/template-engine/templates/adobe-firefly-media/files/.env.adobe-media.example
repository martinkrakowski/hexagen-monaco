# --- Adobe Firefly — Audio/Video (Media) ---
# Audio/Video generation on firefly-api.adobe.io (the core ADOBE_FIREFLY_BASE_URL).
# Jobs run for MINUTES — prefer webhook job_mode (raise ADOBE_WEBHOOK_TIMEOUT_MS),
# and scale up ADOBE_JOB_POLL_INTERVAL_MS if polling.
# Partner-model routing acknowledged at install (partner_model={partner_model}).
# Pass a partner model id (Veo/Runway/Kling/ElevenLabs, where entitled) as the
# per-call model option — it is forwarded unchanged; no partner SDKs are bundled.
ADOBE_FIREFLY_MEDIA_MODEL=firefly-video-v1           # default model id; verify against Adobe docs
