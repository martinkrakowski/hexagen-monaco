# --- Adobe Creative Production API (batch automation) ---
# Maps a published workflow over N assets in one async batch job. Reached via the
# base URL below; it defaults to the image.adobe.io host family (same IMS
# Server-to-Server token as Firefly, NOT firefly-api.adobe.io). Verify the current
# host/path against Adobe docs.
ADOBE_CREATIVE_PRODUCTION_BASE_URL=https://image.adobe.io
