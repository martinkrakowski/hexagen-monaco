# -------- OpenTelemetry (tracing) --------
# Optional — only if you enabled OTel. Install:
#   npm install @opentelemetry/sdk-node @opentelemetry/exporter-trace-otlp-http @opentelemetry/auto-instrumentations-node
# Name this service shows up as in traces.
OTEL_SERVICE_NAME=
# OTLP/HTTP collector endpoint (e.g. a local collector or a vendor URL).
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
