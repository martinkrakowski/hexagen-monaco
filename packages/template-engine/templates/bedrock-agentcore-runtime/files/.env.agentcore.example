# --- Bedrock AgentCore Runtime ---
# Copy into .env.local. The runtime container reads these at startup.

AGENTCORE_AGENT_NAME={agent_name}
AGENTCORE_PROTOCOL={protocol}
AGENTCORE_RUNTIME_PORT=8080
AWS_REGION={aws_region}

# Populated after deploy (agentcore status / CDK stack output): the runtime ARN you invoke.
AGENTCORE_RUNTIME_ARN=

# Inbound auth = {inbound_auth}.
# Set these ONLY for OAuth inbound auth; when AGENTCORE_OAUTH_DISCOVERY_URL is
# set the runtime requires a Bearer token on /invocations (see invocations.handler.ts).
# With IAM inbound auth, AgentCore enforces SigV4 upstream — leave these unset.
# AGENTCORE_OAUTH_DISCOVERY_URL=
# AGENTCORE_OAUTH_ALLOWED_AUDIENCE=
