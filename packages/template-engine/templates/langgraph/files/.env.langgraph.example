# ─── LangGraph ────────────────────────────────────────────────────────────────
# local         — run the graph in-process via the SDK (default)
# langgraph-cloud — point at LangGraph Cloud's hosted endpoint
# self-hosted   — point at a self-hosted LangGraph Platform deployment
LANGGRAPH_DEPLOYMENT={deployment}

# Only used when LANGGRAPH_DEPLOYMENT=langgraph-cloud or self-hosted.
LANGGRAPH_API_URL=
LANGGRAPH_API_KEY=

# ─── Checkpointer ────────────────────────────────────────────────────────────
# Where graph state is persisted between requests / nodes.
# memory   — in-process (default; fine for dev/test, lost on restart)
# supabase — Supabase Postgres via @langchain/langgraph-checkpoint-postgres
# postgres — direct Postgres (DATABASE_URL)
# redis    — @langchain/langgraph-checkpoint-redis (REDIS_URL)
LANGGRAPH_CHECKPOINTER={checkpointing}

# ─── Human-in-the-loop ───────────────────────────────────────────────────────
# Toggles the runtime interrupt for the human-review node (only meaningful
# when you generated the human-in-the-loop scaffolding and wired the node
# into your graph). Leave unset to keep the graph fully autonomous.
LANGGRAPH_HITL_ENABLED=false
