# ─────────────────────────────────────────────────────────────────────────────
# MCP server — HTTP transport (added by mcp-server-http)
# Overrides the stdio defaults in .env.mcp.example. The server REFUSES TO START
# with streamable-http unless MCP_AUTH_MODE is bearer|oauth (see guard.ts).
# ─────────────────────────────────────────────────────────────────────────────
MCP_TRANSPORT=streamable-http
MCP_HTTP_PORT={http_port}

# Auth mode (chosen at install): bearer | oauth — there is no "none", HTTP is
# always authenticated.
MCP_AUTH_MODE={auth}

# bearer: the shared secret clients send as `Authorization: Bearer <token>`.
MCP_BEARER_TOKEN=

# oauth: your OAuth issuer base URL; wire token verification in auth/oauth.ts.
MCP_OAUTH_ISSUER_URL=

# Reserved — NOT YET ENFORCED. A comma-separated tool allowlist. Tool-level
# allowlisting is a cross-transport concern slated for the base tool registry;
# do not rely on this for access control in this version.
MCP_ALLOWED_TOOLS=
