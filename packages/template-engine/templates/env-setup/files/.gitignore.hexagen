
# ─── env-setup: secret-ignore rules ─────────────────────────────────────────
# Append these to your project's .gitignore so real secrets never get committed,
# then delete this sidecar file:
#
#   cat .gitignore.hexagen >> .gitignore && rm .gitignore.hexagen
#
# The leading blank line above keeps these rules from merging onto the last line
# of a .gitignore that has no trailing newline. Ignores your local/secret env
# files but keeps the committed *.example references tracked.

.env
.env.*
!.env.example
!.env.*.example
