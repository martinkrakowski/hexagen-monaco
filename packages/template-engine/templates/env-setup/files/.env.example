# ============================================================
# Environment Variables — reference file (committed to git).
#
# Copy this to .env.local and fill in your values:
#   cp .env.example .env.local
#
# .env.local holds your real values and is gitignored — never commit it.
# A variable with an EMPTY value here is REQUIRED; run the check before first
# run / demo / deploy:
#   npm run check:env
#
# Installed Hexagen templates append their own variables below this base set
# (e.g. the bullmq template ships .env.bullmq.example).
# ============================================================

# -------- App --------
# development | production | test
NODE_ENV=development
# Public base URL of the app (exposed to the browser).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# error | warn | info | debug
LOG_LEVEL=info
