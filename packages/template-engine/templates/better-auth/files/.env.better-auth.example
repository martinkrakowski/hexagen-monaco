# Better Auth — copy these into .env.local

# Required: signing secret
# Generate: openssl rand -hex 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Required: Postgres connection for the Drizzle adapter
DATABASE_URL=postgresql://user:password@localhost:5432/app

# Social providers (each activates only when both vars are set)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Magic link (opt-in): set to true after implementing sendMagicLink() delivery
# BETTER_AUTH_MAGIC_LINK=true
# Email transport for the magic-link plugin
# RESEND_API_KEY=
