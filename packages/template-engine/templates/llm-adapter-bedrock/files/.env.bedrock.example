# -------- Amazon Bedrock (llm-adapter-bedrock) --------
# Auth uses the AWS credential chain (env -> shared profile -> IMDS/IRSA).
# On ECS/Graviton deploys, leave AWS_* unset and grant the task role
# bedrock:InvokeModel / bedrock:Converse. check:env treats AWS_* as optional.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Region is OPTIONAL — leave unset to let the SDK cascade resolve it
# (env -> profile -> IMDS/IRSA). Set it only to pin a region explicitly.
# BEDROCK_REGION={bedrock_region}

# Model ids (cross-region inference profiles). Default chosen at install:
#   {bedrock_inference}
# Override per call tier as needed:
# BEDROCK_REASONING_MODEL=
# BEDROCK_FAST_MODEL=
# BEDROCK_VISION_MODEL=

# Guardrails support wired: {bedrock_guardrails}
# Set an id to attach a Bedrock Guardrail to every Converse call.
# BEDROCK_GUARDRAIL_ID=
# BEDROCK_GUARDRAIL_VERSION=DRAFT
