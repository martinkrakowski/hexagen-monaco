# --- Adobe InDesign API ---
# Enabled operations: {operations}
# The InDesign API is on image.adobe.io (same host family as Photoshop/Lightroom/
# Illustrator, NOT firefly-api.adobe.io). Auth is the same IMS Server-to-Server token.
ADOBE_INDESIGN_BASE_URL=https://image.adobe.io
# Default output format (pdf|jpg|png); exportPdf is always PDF.
ADOBE_INDESIGN_FORMAT={output_format}
