# Adobe IMS SPA (PKCE) — copy these into .env.local
# Get CLIENT_ID from: https://developer.adobe.com/console (Single Page App credential)

ADOBE_IMS_CLIENT_ID=
ADOBE_IMS_REDIRECT_URI=http://localhost:3000/api/auth/callback
ADOBE_IMS_SCOPES=openid,AdobeID,read_organizations
ADOBE_IMS_ENVIRONMENT=prod                    # prod | stage
ADOBE_IMS_AUTO_REFRESH=true                   # silently refresh tokens 5 min before expiry

# Required: used to encrypt the IMS token bundle stored in the session cookie
# Generate: openssl rand -hex 32
AUTH_SESSION_SECRET=
