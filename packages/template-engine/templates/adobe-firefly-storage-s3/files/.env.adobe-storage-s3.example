# --- Adobe Firefly — S3 Presigned Storage ---
# The presigner needs the bucket; region + credentials resolve from the AWS chain
# (AWS_REGION / shared profile / IAM role). Leave ADOBE_S3_REGION unset on AWS
# infra; it only overrides the region. Presigned-URL lifetime is set at install
# time (url_expiry_seconds).
ADOBE_S3_BUCKET=                                     # required
ADOBE_S3_REGION=
ADOBE_S3_PREFIX=
