# --- Adobe Illustrator API ---
# Enabled operations: {operations}
# The Illustrator API is on image.adobe.io (same host family as Photoshop/Lightroom,
# NOT firefly-api.adobe.io). Auth is the same IMS Server-to-Server token.
ADOBE_ILLUSTRATOR_BASE_URL=https://image.adobe.io
# Default output format (png|jpeg|pdf).
ADOBE_ILLUSTRATOR_FORMAT={output_format}
