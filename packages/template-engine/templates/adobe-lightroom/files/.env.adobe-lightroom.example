# --- Adobe Lightroom API ---
# Enabled operations: {operations}
# The Lightroom API is on image.adobe.io (same host as Photoshop, /lrService path;
# NOT firefly-api.adobe.io). Auth is the same IMS Server-to-Server token.
ADOBE_LIGHTROOM_BASE_URL=https://image.adobe.io
# Default output format (jpeg|png).
ADOBE_LIGHTROOM_FORMAT={output_format}
