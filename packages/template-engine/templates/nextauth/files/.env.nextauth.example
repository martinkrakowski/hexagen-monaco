# Auth.js (NextAuth v5) — copy these into .env.local

# Required: signing/encryption secret
# Generate: openssl rand -base64 32
AUTH_SECRET=

# Required in production (the canonical app URL)
AUTH_URL=http://localhost:3000

# Google provider — https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# GitHub provider — https://github.com/settings/developers
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
