# Google OAuth 2.0 — copy these into .env.local
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Credential type: OAuth 2.0 Client ID (Web application)

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google
GOOGLE_OAUTH_SCOPES=openid,email,profile
GOOGLE_HD=                          # optional: restrict to a Google Workspace domain (e.g. company.com)

# Required: encrypt the session cookie
# Generate: openssl rand -hex 32
AUTH_SESSION_SECRET=
