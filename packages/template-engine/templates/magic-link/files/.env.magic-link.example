# Magic Link (Passwordless) — copy these into .env.local

# Required: signs the magic link tokens
# Generate: openssl rand -hex 32
MAGIC_LINK_SECRET=

MAGIC_LINK_TTL_MINUTES=15
MAGIC_LINK_FROM=noreply@example.com
MAGIC_LINK_TRANSPORT=resend            # resend | nodemailer
APP_URL=http://localhost:3000

# Resend transport (default)
# Sign up at https://resend.com to get an API key
RESEND_API_KEY=

# Nodemailer transport (alternative — requires: npm install nodemailer)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# Required: encrypt the session cookie
# Generate: openssl rand -hex 32
AUTH_SESSION_SECRET=
