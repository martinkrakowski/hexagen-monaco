# Microsoft Entra ID (Azure AD) — copy these into .env.local
# Register an app at: https://portal.azure.com > Azure Active Directory > App registrations

ENTRA_TENANT_ID=                             # Azure AD tenant ID (GUID)
ENTRA_CLIENT_ID=                             # App Registration > Overview > Application (client) ID
ENTRA_CLIENT_SECRET=                         # App Registration > Certificates & secrets
ENTRA_REDIRECT_URI=http://localhost:3000/api/auth/callback/entra
ENTRA_SCOPES=openid,profile,email,User.Read

# Group → role mapping (optional)
# Requires GroupMember.Read.All permission on Microsoft Graph, or groupMembershipClaims=SecurityGroup in app manifest
ENTRA_GROUP_ROLE_MAPPING=false
# ENTRA_GROUP_ROLE_MAP={"<group-object-id>":"admin","<group-object-id>":"editor"}

# Required: encrypt the session cookie
# Generate: openssl rand -hex 32
AUTH_SESSION_SECRET=
