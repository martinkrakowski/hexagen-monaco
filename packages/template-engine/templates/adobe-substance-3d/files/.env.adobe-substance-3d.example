# --- Adobe Substance 3D API ---
# Enabled operations: {operations}
# The Substance 3D API is on the image.adobe.io host family (same IMS
# Server-to-Server token as Firefly, NOT firefly-api.adobe.io). These are the
# longest-running Firefly jobs; they are polled by status URL regardless of
# job_mode (image.adobe.io services don't deliver Firefly webhooks, so webhook
# mode / ADOBE_WEBHOOK_TIMEOUT_MS do NOT apply). The poll has no max-wait cap, so
# a long render isn't cut off — raise ADOBE_JOB_POLL_INTERVAL_MS to throttle
# status checks. Verify the current host/path against Adobe docs.
ADOBE_SUBSTANCE_3D_BASE_URL=https://image.adobe.io
# Default output image format (png|jpg).
ADOBE_SUBSTANCE_3D_FORMAT={output_format}
