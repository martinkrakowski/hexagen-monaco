# --- Adobe Firefly — GCS Presigned Storage ---
# The presigner needs the bucket; credentials resolve from the Google Application
# Default Credentials chain (GOOGLE_APPLICATION_CREDENTIALS / Cloud Run / GCE
# metadata). V4 signing uses the service-account key locally, or the IAM SignBlob
# API when no key file is present. Presigned-URL lifetime is set at install time
# (url_expiry_seconds).
ADOBE_GCS_BUCKET=                                    # required
ADOBE_GCS_PREFIX=
