{
  "name": "@hexagen/shared",
  "version": "0.11.0",
  "type": "module",
  "description": "HexaGen shared types and utilities",
  "license": "SEE LICENSE IN LICENSE",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc && node ../../scripts/fix-esm-barrels.js dist",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "js-yaml": "^4.1.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "eslint": "^8.57.0",
    "typescript": "^5.4.5",
    "vitest": "^4.1.9"
  },
  "private": true
}
