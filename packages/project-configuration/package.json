{
  "name": "@hexagen/project-configuration",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "lint": "eslint . --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test __tests__/**/*.test.ts __tests__/**/*.spec.ts || true",
    "test:watch": "tsx --test --watch __tests__/**/*.test.ts __tests__/**/*.spec.ts",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@hexagen/shared": "workspace:*",
    "@hexagen/sync": "workspace:*",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.0.0"
  }
}
