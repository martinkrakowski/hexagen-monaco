{
  "name": "@hexagen/project-configuration",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "source": "./src/index.ts",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/index.server.d.ts",
      "source": "./src/index.server.ts",
      "default": "./dist/index.server.js"
    }
  },
  "scripts": {
    "build": "tsc && node ../../scripts/fix-esm-barrels.js dist",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test __tests__/**/*.test.ts __tests__/**/*.spec.ts || true",
    "test:watch": "tsx --test --watch __tests__/**/*.test.ts __tests__/**/*.spec.ts",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@hexagen/shared": "workspace:*",
    "js-yaml": "^4.1.1",
    "jszip": "^3.10.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/jszip": "^3.4.1",
    "@types/node": "^20.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.0.0"
  }
}
