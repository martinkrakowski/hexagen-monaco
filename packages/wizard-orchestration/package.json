{
  "name": "@hexagen/wizard-orchestration",
  "version": "0.7.1",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/fix-esm-barrels.js dist",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx/esm --test \"src/__tests__/**/*.test.ts\""
  },
  "dependencies": {
    "@hexagen/project-configuration": "workspace:*",
    "@hexagen/shared": "workspace:*",
    "@hexagen/sync": "workspace:*",
    "js-yaml": "^4.1.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  }
}
