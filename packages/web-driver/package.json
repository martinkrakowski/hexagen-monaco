{
  "name": "@hexagen/web-driver",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "source": "./src/index.ts",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./infrastructure/constants": {
      "types": "./dist/infrastructure/constants/index.d.ts",
      "source": "./src/infrastructure/constants/index.ts",
      "default": "./dist/infrastructure/constants/index.js"
    },
    "./__tests__/fixtures": {
      "types": "./dist/__tests__/fixtures/index.d.ts",
      "source": "./src/__tests__/fixtures/index.ts",
      "default": "./dist/__tests__/fixtures/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest"
  },
  "dependencies": {
    "@hexagen/agentic-interaction": "workspace:*",
    "@hexagen/shared": "workspace:*",
    "@hexagen/visualization": "workspace:*",
    "js-yaml": "^4.1.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  }
}
