{
  "name": "@hexagen/project-generation",
  "version": "0.4.1",
  "main": "dist/index.js",
  "source": "./src/index.ts",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test __tests__/**/*.test.ts __tests__/**/*.spec.ts || true",
    "test:watch": "tsx --test --watch __tests__/**/*.test.ts __tests__/**/*.spec.ts",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@hexagen/project-configuration": "workspace:*",
    "@hexagen/shared": "workspace:*",
    "@hexagen/sync": "workspace:^",
    "@octokit/rest": "^20.1.0",
    "js-yaml": "^4.1.1",
    "jszip": "^3.10.1",
    "zod": "^3.x.x"
  },
  "devDependencies": {
    "@types/js-yaml": "^4",
    "@types/jszip": "^3.4.1",
    "@types/node": "^20.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.4.5"
  },
  "private": true,
  "type": "module"
}
