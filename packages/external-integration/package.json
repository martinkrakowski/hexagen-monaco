  },
  "dependencies": {
    "@hexagen/project-generation": "workspace:*",
    "@hexagen/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "eslint": "^8.57.0",
    "tsx": "^4.21.0",
    "typescript": "^5.4.5",
    "vitest": "^4.1.9"
  }
