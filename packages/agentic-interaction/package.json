{
  "name": "@hexagen/agentic-interaction",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "source": "./src/index.ts",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./sanitize-pseudo-yaml": {
      "types": "./dist/domain/utils/sanitize-pseudo-yaml.d.ts",
      "source": "./src/domain/utils/sanitize-pseudo-yaml.ts",
      "default": "./dist/domain/utils/sanitize-pseudo-yaml.js"
    },
    "./manifest-dialect": {
      "types": "./dist/domain/utils/manifest-dialect.d.ts",
      "source": "./src/domain/utils/manifest-dialect.ts",
      "default": "./dist/domain/utils/manifest-dialect.js"
    }
  },
  "scripts": {
    "build": "tsc && node ../../scripts/fix-esm-barrels.js dist",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "golden-harness": "tsx scripts/golden-manifest-harness.ts",
    "test:review": "vitest run",
    "test:jest": "jest --config jest.config.cjs",
    "test:watch": "vitest watch",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@hexagen/ai-pipeline": "workspace:*",
    "@hexagen/core-domain": "workspace:*",
    "@hexagen/local-llm": "workspace:*",
    "@hexagen/project-configuration": "workspace:*",
    "@hexagen/prompt-compiler": "workspace:*",
    "@hexagen/reconciliation-engine": "workspace:*",
    "@hexagen/shared": "workspace:*",
    "@hexagen/transaction-system": "workspace:*",
    "js-yaml": "^4.1.1",
    "jsonrepair": "^3.14.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "ts-jest": "^29.4.10",
    "tsx": "^4.19.2"
  }
}
