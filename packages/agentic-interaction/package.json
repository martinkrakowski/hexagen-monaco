{
  "name": "@hexagen/agentic-interaction",
  "version": "0.4.2",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "source": "./src/index.ts",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc && node ../../scripts/fix-esm-barrels.js dist",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test __tests__/**/*.test.ts",
    "test:review": "tsx --test __tests__/**/*.test.ts",
    "test:jest": "jest --config jest.config.cjs",
    "test:watch": "tsx --test --watch __tests__/**/*.test.ts __tests__/**/*.spec.ts",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@hexagen/ai-pipeline": "workspace:*",
    "@hexagen/core-domain": "workspace:*",
    "@hexagen/local-llm": "workspace:*",
    "@hexagen/prompt-compiler": "workspace:*",
    "@hexagen/reconciliation-engine": "workspace:*",
    "@hexagen/shared": "workspace:*",
    "@hexagen/transaction-system": "workspace:*",
    "js-yaml": "^4.1.1",
    "jsonrepair": "^3.14.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "ts-jest": "^29.4.10",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3"
  }
}
