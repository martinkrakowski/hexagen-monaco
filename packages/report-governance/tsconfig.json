{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "emitDeclarationOnly": false,
    "declarationMap": true,
    "composite": true,
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "paths": {}
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", ".turbo", "src/**/__tests__/**"],
  "references": [{ "path": "../shared" }]
}
