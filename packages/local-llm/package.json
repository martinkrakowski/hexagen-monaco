{
  "name": "@hexagen/local-llm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "source": "./src/index.ts",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/fix-esm-barrels.js dist",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"__tests__/**/*.test.ts\"",
    "test:watch": "tsx --test --watch __tests__/**/*.test.ts __tests__/**/*.spec.ts"
  },
  "dependencies": {
    "@hexagen/governance": "workspace:*",
    "@hexagen/project-configuration": "workspace:*",
    "@hexagen/prompt-compiler": "workspace:*",
    "@hexagen/shared": "workspace:*",
    "@hexagen/visualization": "workspace:*",
    "idb-keyval": "^6.2.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.0.0"
  }
}
