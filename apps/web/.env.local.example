# LLM Configuration
# Get your API key from https://platform.openai.com/api-keys
LLM_API_KEY=

# Base URL for LLM API (default: OpenAI)
LLM_BASE_URL=https://api.openai.com/v1

# Model to use (default: gpt-4o-mini)
LLM_MODEL=gpt-4o-mini

NEXT_PUBLIC_LLM_AVAILABLE=true

# Free Tier Model Configuration
# Set to true if using a rate-limited free tier model (e.g., NVIDIA free tier at 40 tps)
NEXT_PUBLIC_FREE_TIER_MODEL=false

# Optional: Override for development
