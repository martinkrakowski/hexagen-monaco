# LLM Configuration
# Get your API key from https://platform.openai.com/api-keys
NEXT_PUBLIC_LLM_API_KEY=

# Base URL for LLM API (default: OpenAI)
NEXT_PUBLIC_LLM_BASE_URL=https://api.openai.com/v1

# Model to use (default: gpt-4o-mini)
NEXT_PUBLIC_LLM_MODEL=gpt-4o-mini

# Optional: Override for development
# NEXT_PUBLIC_LLM_API_KEY=sk-your-key-here