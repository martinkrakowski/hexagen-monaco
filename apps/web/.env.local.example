# LLM Configuration
# Get your API key from https://platform.openai.com/api-keys
LLM_API_KEY=

# Base URL for LLM API (default: OpenAI)
LLM_BASE_URL=https://api.openai.com/v1

# Model to use (default: gpt-4o-mini)
LLM_MODEL=gpt-4o-mini

NEXT_PUBLIC_LLM_AVAILABLE=true

# Inception Labs (Mercury diffusion models) — optional extra provider in the
# cloud fallback chain; activates when the key is set.
# Mercury reasons by default (reasoning_effort=medium): set
# LLM_REASONING=disabled to map it to reasoning_effort=instant.
INCEPTION_API_KEY=
# INCEPTION_MODEL=mercury-2

# Reasoning control for reasoning-capable models (LLM_* generic endpoint and
# Inception only): disabled | low | medium | high. Unset = provider default.
# LLM_REASONING=

# Free Tier Model Configuration
# Set to true if using a rate-limited free tier model (e.g., NVIDIA free tier at 40 tps)
NEXT_PUBLIC_FREE_TIER_MODEL=false

# Optional: Override for development

# Jev decision advice (Jev J5a1) — off unless the dedicated key is set.
# JEV_API_KEY=
# JEV_CONTEXT_TYPE_MODE=off            # off (default) | shadow | primary
# JEV_CONTEXT_TYPE_MIN_CONFIDENCE=0.8  # clamped to 0..1
# JEV_MAX_CALLS_PER_GENERATION=20
# JEV_DAILY_COST_CEILING_USD=0.50
# JEV_TEMPLATE_SUGGEST=off             # on | off (default off)
# JEV_REVIEWER_SUB=
