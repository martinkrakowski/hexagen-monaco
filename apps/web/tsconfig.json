{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "allowJs": true,
    "incremental": true,
    "lib": ["dom", "dom.iterable", "esnext"],
    "resolveJsonModule": true,
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./app/*",
        "./components/*",
        "./lib/*",
        "./hooks/*",
        "./features/*",
        "./types/*"
      ],
      "@/contexts/*": ["./app/contexts/*"],
      "@/types/*": ["./types/*"],
      "monaco-editor": ["./node_modules/monaco-editor"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "types/**/*.ts",
    "types/**/*.d.ts",
    "components/**/*",
    "lib/**/*",
    "hooks/**/*",
    "features/**/*"
  ],
  "references": [
    {
      "path": "../../packages/governance"
    },
    {
      "path": "../../packages/project-generation"
    },
    {
      "path": "../../packages/project-configuration"
    },
    {
      "path": "../../packages/wizard-orchestration"
    },
    {
      "path": "../../packages/monaco-orchestration"
    },
    {
      "path": "../../packages/web-driver"
    },
    {
      "path": "../../packages/visualization"
    },
    {
      "path": "../../packages/local-llm"
    },
    {
      "path": "../../packages/model-settings"
    },
    {
      "path": "../../packages/shared"
    },
    {
      "path": "../../packages/llm-driver"
    }
  ],
  "exclude": [
    "node_modules",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "vitest.config.ts"
  ]
}
