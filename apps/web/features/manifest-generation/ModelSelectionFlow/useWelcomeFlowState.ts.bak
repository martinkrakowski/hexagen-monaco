  // Run a smoke test on the model with a timeout
  const runSmokeTest = useCallback(async (modelId: DomainModelId) => {
    try {
      // Create a timeout promise that rejects after 5 seconds
      const timeoutPromise = new Promise<AsyncIterable<string>>((_, reject) => {
        setTimeout(() => reject(new Error("Smoke test timed out after 5 seconds")), 5000);
      });
      
      // Use Promise.race to implement the timeout
      await Promise.race([
        llmContext.sendGovernanceMessage(
          "Respond with 'OK'",
          "You are a test helper. Reply only with the word OK.",
        ),
        timeoutPromise
      ]);
      
      // If successful, update the verification timestamp
      saveModelCacheMetadata(modelId, {
        verifiedAt: Date.now()
      });
      
      // Proceed to generation
      setFlowState(prev => ({ 
        ...prev, 
        state: "generating", 
        isModelReady: true 
      }));
    } catch (error) {
      console.error("Model smoke test failed:", error);
      
      // Mark as corrupted and offer repair option
      setFlowState(prev => ({ 
        ...prev, 
        state: "error",
        error: "The model cache appears to be corrupted. Please repair the download.",
        errorCode: "model_corrupted" as WelcomeFlowErrorCode,
        isModelReady: false,
      }));
    }
  }, [llmContext]);
  
  // Repair a corrupted model download
  const repairModelDownload = useCallback(async (modelId: DomainModelId) => {
    try {
      // Cancel any ongoing downloads
      cancelDownload();
      
      // Clear the cache metadata
      clearModelCacheMetadata(modelId);
      
      // Restart the download process
      setFlowState(prev => ({
        ...prev,
        state: "model_downloading",
        error: null,
        errorCode: null,
        generationProgress: 0
      }));
      
      // Re-initialize the model (which will trigger a fresh download)
      await initializeModel(modelId);
    } catch (error) {
      setFlowState(prev => ({
        ...prev,
        state: "error",
        error: error instanceof Error ? error.message : "Failed to repair model download",
        errorCode: "network_failure" as WelcomeFlowErrorCode
      }));
    }
  }, [cancelDownload, initializeModel]);