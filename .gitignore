# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ───────────────────────────────────────────────
# Package manager (Yarn Berry / PnP)
# ───────────────────────────────────────────────
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.yarnrc.yml
.pnp.*
.pnp.js
/.pnp
.yarn/install-state.gz

# ───────────────────────────────────────────────
# Dependencies & build artifacts
# ───────────────────────────────────────────────
node_modules/
.turbo/
.turbo
.next/
.next.cache/
dist/
build/
# out/
**/dist/
**/build/
# **/out/

# ───────────────────────────────────────────────
# TypeScript & build info
# ───────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ───────────────────────────────────────────────
# Logs and debug files
# ───────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# ───────────────────────────────────────────────
# Environment variables (never commit secrets)
# ───────────────────────────────────────────────
.env
.env.local
.env.*.local
!.env.example

# ───────────────────────────────────────────────
# OS / editor / IDE generated files
# ───────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ───────────────────────────────────────────────
# Temporary / generated / project-specific files
# ───────────────────────────────────────────────
*.zip
generated-*.zip
temp-*
.webcontainer/
downloads/
.cache/
*.pem

# ───────────────────────────────────────────────
# Test coverage
# ───────────────────────────────────────────────
coverage/
.nyc_output/
*.lcov

# ───────────────────────────────────────────────
# HexaGen generated layer barrels & index files
# Auto-created by yarn sync — never commit them
# Real source files (.port.ts, .use-case.ts, etc.) remain tracked
# ───────────────────────────────────────────────
# Standard src/ layout
packages/*/src/domain/index.ts
packages/*/src/application/index.ts
packages/*/src/application/ports/in/index.ts
packages/*/src/application/ports/out/index.ts
packages/*/src/application/use-cases/index.ts
packages/*/src/infrastructure/index.ts
packages/*/src/infrastructure/adapters/index.ts

# Flattened layout (no src/ folder)
packages/*/domain/index.ts
packages/*/application/index.ts
packages/*/application/ports/in/index.ts
packages/*/application/ports/out/index.ts
packages/*/application/use-cases/index.ts
packages/*/infrastructure/index.ts
packages/*/infrastructure/adapters/index.ts

# Future-proof catch-all for any nested index.ts barrels
# packages/**/index.ts
