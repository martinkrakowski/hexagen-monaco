# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ───────────────────────────────────────────────
# Package manager (Yarn Berry / PnP)
# ───────────────────────────────────────────────
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnp.*
.pnp.js
/.pnp
.yarn/install-state.gz

# ───────────────────────────────────────────────
# Dependencies & build artifacts
# ───────────────────────────────────────────────
node_modules/
.turbo/
.turbo
.next/
.next.cache/
dist/
build/
# out/
**/dist/
**/build/
# **/out/

# ───────────────────────────────────────────────
# TypeScript & build info
# ───────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# Prevent build artifacts in src/ (build artifacts belong in dist/)
packages/*/src/**/*.d.ts
packages/*/src/**/*.d.ts.map
packages/*/src/**/*.js
!packages/*/src/**/*.types.d.ts

# ───────────────────────────────────────────────
# Logs and debug files
# ───────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# ───────────────────────────────────────────────
# Environment variables (never commit secrets)
# ───────────────────────────────────────────────
.env
.env.local
.env.*.local
!.env.example

# ───────────────────────────────────────────────
# OS / editor / IDE generated files
# ───────────────────────────────────────────────
.DS_Store
Thumbs.db

# VS Code - Ignore all internal state, but version the shared config
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Zed - Ignore all internal state, but version the shared config
.zed/*
!.zed/settings.json

.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ───────────────────────────────────────────────
# AI agent skills & tooling
# ───────────────────────────────────────────────
.claude/
.continue/
.cursor/
skills-lock.json
skills/

# ───────────────────────────────────────────────
# Temporary / generated / project-specific files
# ───────────────────────────────────────────────
*.zip
generated-*.zip
temp-*
.webcontainer/
downloads/
.cache/
*.pem

# ───────────────────────────────────────────────
# Test coverage
# ───────────────────────────────────────────────
coverage/
.nyc_output/
*.lcov

# ───────────────────────────────────────────────
# HexaGen generated files
# ───────────────────────────────────────────────
# NOTE: Barrel index.ts files are now committed.
# They are generated by `yarn sync` but required for builds.
# Previously these were gitignored, but CI needs them to compile.
SYNC-MIGRATION-REPORT.md
