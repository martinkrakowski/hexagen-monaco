{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*", "NODE_ENV"],
  "globalEnv": [
    "APP_VERSION",
    "CI",
    "COMMIT_HASH",
    "DEBUG",
    "GITHUB_ID",
    "GITHUB_SECRET",
    "HEXAGEN_ROOT",
    "NEXTAUTH_SECRET",
    "NEXTAUTH_URL",
    "NEXT_PUBLIC_LLM_API_KEY",
    "NEXT_PUBLIC_LLM_BASE_URL",
    "NEXT_PUBLIC_LLM_MODEL",
    "NODE_ENV",
    "TEST_RESOLVE_API_KEY",
    "TEST_RESOLVE_MISSING_KEY",
    "TEST_RESOLVE_EMPTY_KEY",
    "TEST_PRIMARY_KEY",
    "TEST_FALLBACK_KEY",
    "TEST_OPENAI_API_KEY",
    "TEST_OPENAI_FALLBACK_API_KEY"
  ],
  "pipeline": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "__tests__/**/*.ts",
        "__tests__/**/*.tsx",
        "tests/**/*.ts",
        "tsconfig*.json",
        "package.json"
      ],
      "outputs": [],
      "cache": false
    },
    "typecheck:test": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "__tests__/**/*.ts",
        "__tests__/**/*.tsx",
        "tests/**/*.ts",
        "tsconfig*.json",
        "package.json"
      ],
      "outputs": [],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": [],
      "cache": true
    }
  }
}
