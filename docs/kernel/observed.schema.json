{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://hexagen.dev/kernel/observed.schema.json",
  "title": "Observed report",
  "description": "`.hexagen/observed.json`: what a scan found in a client repo, in the repo's own names. Observed is kept apart from proposed, so no object has a `type`, `layer`, `plane` or `context` property and every object forbids extra properties. Each section has a `collected: false` arm with a reason, so an empty list never reads as a clean tree. Mirrors packages/shared/src/types/brownfield/observed.ts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "repo",
    "generatedAt",
    "packages",
    "languages",
    "build",
    "generated",
    "dontTouch",
    "edges",
    "unresolved",
    "limits"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.\\d+\\.\\d+$",
      "description": "Schema version. Consumers understand the 1.x line only."
    },
    "repo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit"],
      "properties": {
        "remote": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "packages": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["collected", "items"],
          "properties": {
            "collected": {
              "const": true
            },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "root", "manifestFile"],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Exactly as written in the package manifest, scope included."
                  },
                  "root": {
                    "type": "string",
                    "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*[\\\\\\u0000-\\u001f\\u007f\\u2028\\u2029]).+$",
                    "description": "Repo-relative, case-sensitive. Control characters (U+0000-U+001F, U+007F, U+2028, U+2029) are also refused. A trailing / makes a directory prefix; anything else is an exact file path. `.` and `..` segments, empty segments, absolute paths, backslashes and NUL are refused."
                  },
                  "manifestFile": {
                    "type": "string",
                    "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*[\\\\\\u0000-\\u001f\\u007f\\u2028\\u2029]).+$",
                    "description": "Repo-relative, case-sensitive. Control characters (U+0000-U+001F, U+007F, U+2028, U+2029) are also refused. A trailing / makes a directory prefix; anything else is an exact file path. `.` and `..` segments, empty segments, absolute paths, backslashes and NUL are refused."
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["collected", "reason"],
          "properties": {
            "collected": {
              "const": false
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "languages": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["collected", "items"],
          "properties": {
            "collected": {
              "const": true
            },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "fileCount"],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "fileCount": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["collected", "reason"],
          "properties": {
            "collected": {
              "const": false
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "build": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["collected", "items"],
          "properties": {
            "collected": {
              "const": true
            },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["marker", "path"],
                "properties": {
                  "marker": {
                    "type": "string",
                    "minLength": 1
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["collected", "reason"],
          "properties": {
            "collected": {
              "const": false
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "generated": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["collected", "items"],
          "properties": {
            "collected": {
              "const": true
            },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["path", "source"],
                "properties": {
                  "path": {
                    "type": "string",
                    "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*[\\\\\\u0000-\\u001f\\u007f\\u2028\\u2029]).+$",
                    "description": "Repo-relative, case-sensitive. Control characters (U+0000-U+001F, U+007F, U+2028, U+2029) are also refused. A trailing / makes a directory prefix; anything else is an exact file path. `.` and `..` segments, empty segments, absolute paths, backslashes and NUL are refused."
                  },
                  "source": {
                    "enum": [
                      "linguist-generated",
                      "header",
                      "gitignored-build-dir"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["collected", "reason"],
          "properties": {
            "collected": {
              "const": false
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "dontTouch": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["collected", "items"],
          "properties": {
            "collected": {
              "const": true
            },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["path", "source"],
                "properties": {
                  "path": {
                    "type": "string",
                    "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*[\\\\\\u0000-\\u001f\\u007f\\u2028\\u2029]).+$",
                    "description": "Repo-relative, case-sensitive. Control characters (U+0000-U+001F, U+007F, U+2028, U+2029) are also refused. A trailing / makes a directory prefix; anything else is an exact file path. `.` and `..` segments, empty segments, absolute paths, backslashes and NUL are refused."
                  },
                  "source": {
                    "enum": ["flag", "codeowners"]
                  },
                  "owner": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["collected", "reason"],
          "properties": {
            "collected": {
              "const": false
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "edges": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["collected", "unreadLanguages", "items"],
          "properties": {
            "collected": {
              "const": true
            },
            "unreadLanguages": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "description": "Languages the import pass does not read; their edges are absent, not zero. Required; an empty array says every language was read."
            },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["from", "to", "specifier"],
                "properties": {
                  "from": {
                    "type": "string",
                    "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*[\\\\\\u0000-\\u001f\\u007f\\u2028\\u2029]).+$",
                    "description": "Repo-relative file."
                  },
                  "to": {
                    "type": "string",
                    "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*[\\\\\\u0000-\\u001f\\u007f\\u2028\\u2029]).+$",
                    "description": "Repo-relative file or package root."
                  },
                  "specifier": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["collected", "reason"],
          "properties": {
            "collected": {
              "const": false
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "unresolved": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["collected", "items"],
          "properties": {
            "collected": {
              "const": true
            },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["from", "specifier", "reason"],
                "properties": {
                  "from": {
                    "type": "string",
                    "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*[\\\\\\u0000-\\u001f\\u007f\\u2028\\u2029]).+$",
                    "description": "Repo-relative, case-sensitive. Control characters (U+0000-U+001F, U+007F, U+2028, U+2029) are also refused. A trailing / makes a directory prefix; anything else is an exact file path. `.` and `..` segments, empty segments, absolute paths, backslashes and NUL are refused."
                  },
                  "specifier": {
                    "type": "string",
                    "minLength": 1
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["collected", "reason"],
          "properties": {
            "collected": {
              "const": false
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["truncated", "reasons"],
      "properties": {
        "truncated": {
          "type": "boolean"
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "maxFiles": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
