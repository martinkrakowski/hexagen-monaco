{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://hexagen.dev/kernel/proposal.schema.json",
  "title": "Proposal metadata",
  "description": "`.hexagen/proposals/<id>.json`, beside `<id>.patch`. Mirrors packages/shared/src/types/brownfield/proposal.ts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "grantId",
    "sliceId",
    "tool",
    "paths",
    "traceSeq",
    "createdAt"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "grantId": {
      "type": "string",
      "minLength": 1
    },
    "sliceId": {
      "type": "string",
      "minLength": 1
    },
    "tool": {
      "type": "string",
      "minLength": 1
    },
    "paths": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*[\\\\\\u0000-\\u001f\\u007f\\u2028\\u2029]).+$",
        "description": "A file path: no trailing /.",
        "not": {
          "anyOf": [
            {
              "pattern": "/$"
            }
          ]
        }
      }
    },
    "traceSeq": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
