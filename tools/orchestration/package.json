    "hexagen-orchestration-mutate-anchors": "dist/bins/mutate-anchors.js",
    "hexagen-orchestration-mutate-verify": "dist/bins/mutate-verify.js",
    "hexagen-orchestration-plan-review": "dist/bins/plan-review.js",
