    "hexagen-orchestration-gate": "dist/bins/gate.js",
    "hexagen-orchestration-gate-lock": "bin/gate-lock",
    "hexagen-orchestration-handoff-check": "dist/bins/handoff-check.js",
    "hexagen-orchestration-init": "dist/bins/init.js",
    "hexagen-orchestration-merge-prs": "bin/merge-prs",
